# ── VITS2 INT8 TTS ──────────────────────────────────────────────
# Base: official phanthy-motus perception (jp511-torch, ROS Humble)
# Overlays VITS2-Mix INT8 model + G2P frontend
# ────────────────────────────────────────────────────────────────

ARG BASE_IMAGE=bj-warehouse.tencentcloudcr.com/phanthy-motus/jetson-base:jp511-torch
FROM ${BASE_IMAGE}

# ── System deps ────────────────────────────────────────────────
RUN apt-get update && \
    apt-get install -y --no-install-recommends espeak-ng ffmpeg && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# ── audio_msgs ──────────────────────────────────────────────────
COPY deploy/ros-base/audio_msgs/ /ros_ws/src/audio_msgs/
RUN cd /ros_ws && \
    . /opt/ros/humble/install/setup.bash && \
    colcon build --packages-select audio_msgs --cmake-args -DCMAKE_BUILD_TYPE=Release

# ── Python deps ────────────────────────────────────────────────
ARG PIP_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple/
RUN pip3 install --no-cache-dir -i ${PIP_MIRROR} \
    pyyaml requests websockets && \
    pip3 install --no-cache-dir --no-deps -i ${PIP_MIRROR} silero-vad && \
    pip3 install --no-cache-dir -i ${PIP_MIRROR} \
    numpy scipy pypinyin jieba soundfile wetext inflect g2p-en nltk cn2an

# ── VITS2 model + source download ──────────────────────────────
ARG MODEL_BASE_URL=http://172.28.4.81:34567/zhangjinghong/vits2_submit
RUN mkdir -p /models/vits2-mix/vits2/text /models/vits2-mix/frontend /models/vits2-mix/tn_cache && \
    cd /models/vits2-mix && \
    curl -fsSL -o G_B_final_int8.pth "${MODEL_BASE_URL}/G_B_final_int8.pth" && \
    curl -fsSL -o config.json "${MODEL_BASE_URL}/config.json" && \
    for f in models.py modules.py commons.py attentions.py transforms.py stft.py utils.py monotonic_align.py; do \
        curl -fsSL -o "vits2/$f" "${MODEL_BASE_URL}/vits2_src/$f"; \
    done && \
    curl -fsSL -o vits2/text/__init__.py "${MODEL_BASE_URL}/vits2_src/text/__init__.py" && \
    curl -fsSL -o vits2/text/symbols.py "${MODEL_BASE_URL}/vits2_src/text/symbols.py" && \
    for f in __init__.py cleaner.py chinese.py english.py heteronym.py tone_sandhi.py unified_g2p.py symbols.py cmudict.rep cmudict_cache.pickle; do \
        curl -fsSL -o "frontend/$f" "${MODEL_BASE_URL}/frontend/$f"; \
    done && \
    curl -fsSL -o frontend/opencpop-strict.txt "${MODEL_BASE_URL}/opencpop-strict.txt" && \
    for f in zh_tn_tagger.fst zh_tn_verbalizer.fst en_tn_tagger.fst en_tn_verbalizer.fst; do \
        curl -fsSL -o "tn_cache/$f" "${MODEL_BASE_URL}/tn_cache/$f"; \
    done && \
    echo "Model files:" && ls -lh G_B_final_int8.pth config.json && \
    TNPKG=$(python3 -c "import site; print(site.getsitepackages()[0])")/tn/chinese && \
    mkdir -p $TNPKG && \
    printf 'class Normalizer:\n    def __init__(self,**kw):pass\n    def normalize(self,t):return t\n' > $TNPKG/normalizer.py && \
    touch $TNPKG/../__init__.py $TNPKG/__init__.py && \
    echo "tn stub created"

# ── Application code ───────────────────────────────────────────
WORKDIR /work
COPY perception/main.py    /work/main.py
COPY perception/plugins/   /work/plugins/
COPY perception/utils/     /work/utils/
COPY perception/config.yaml /work/config.yaml

EXPOSE 15720 15721

RUN find /ros_ws/install -name "site-packages" -type d > /usr/local/lib/python3.8/dist-packages/ros_ws.pth && \
    find /opt/ros/humble/install -name "site-packages" -type d >> /usr/local/lib/python3.8/dist-packages/ros_ws.pth

ENV LD_LIBRARY_PATH="/ros_ws/install/audio_msgs/lib:/opt/ros/humble/install/lib:${LD_LIBRARY_PATH}"
ENV AMENT_PREFIX_PATH="/ros_ws/install/audio_msgs:/opt/ros/humble/install"

CMD ["/bin/bash", "-c", \
    "export LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libgomp.so.1 && \
     source /opt/ros/humble/install/setup.bash && \
     source /ros_ws/install/setup.bash && \
     python3 /work/main.py"]
