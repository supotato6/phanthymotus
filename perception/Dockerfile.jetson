# ── Jetson JP6 variant — VITS2 INT8 TTS ────────────────────────────
# Self-contained JP6+torch from public dustynv images (no private registry).
#
# Usage:
#   docker build -f perception/Dockerfile.jetson --network=host \
#     -t phanthymotus-perception-tts:latest .
# ────────────────────────────────────────────────────────────────────

ARG PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple/
ARG ROS_BASE=docker.m.daocloud.io/dustynv/ros:humble-desktop-l4t-r36.4.0
ARG PYTORCH_DONOR=docker.m.daocloud.io/dustynv/l4t-pytorch:r36.4.0

# ── Stage: jp6-torch (copy from dustynv) ─────────────────────────
FROM ${PYTORCH_DONOR} AS pytorch-donor
FROM ${ROS_BASE} AS jp6-torch-built
RUN rm -f /etc/apt/sources.list.d/* && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* && \
    apt-get -o Acquire::AllowInsecureRepositories=true update && \
    apt-get install -y --no-install-recommends --allow-unauthenticated libopenblas-base && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*
COPY --from=pytorch-donor /usr/local/lib/python3.10/dist-packages/ /tmp/pt-donor/
RUN cd /tmp/pt-donor && \
    mkdir -p /usr/local/lib/python3.10/dist-packages && \
    for item in torch torchgen torchvision triton; do \
        if [ -e "$item" ]; then cp -a "$item" /usr/local/lib/python3.10/dist-packages/; fi; \
    done && \
    shopt -s nullglob && \
    for item in torch-*.dist-info torchvision-*.dist-info triton-*.dist-info; do \
        cp -a "$item" /usr/local/lib/python3.10/dist-packages/; \
    done && \
    rm -rf /tmp/pt-donor

FROM jp6-torch-built
ARG PYPI_MIRROR

ENV PIP_INDEX_URL=${PYPI_MIRROR} \
    PIP_EXTRA_INDEX_URL= \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1

# ── System deps ──────────────────────────────────────────────────
RUN rm -f /etc/apt/sources.list.d/* && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* && \
    apt-get -o Acquire::AllowInsecureRepositories=true update && \
    apt-get install -y --no-install-recommends --allow-unauthenticated \
      ffmpeg espeak-ng && \
    apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# ── audio_msgs ────────────────────────────────────────────────────
COPY deploy/ros-base/audio_msgs/ /ros_ws/src/audio_msgs/
RUN cd /ros_ws && \
    . /opt/ros/humble/install/setup.bash && \
    colcon build --packages-select audio_msgs --cmake-args -DCMAKE_BUILD_TYPE=Release

# ── Python deps (TTS only, no VOP/OCR/ASR) ──────────────────────
RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
    pyyaml requests onnxruntime && \
    pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
    numpy scipy pypinyin jieba wetext inflect g2p-en nltk cn2an && \
    python3 -c "import nltk; nltk.download('averaged_perceptron_tagger_eng'); nltk.download('cmudict')"

# ── VITS2 model + source download ────────────────────────────────
ARG MODEL_BASE_URL=http://172.28.4.81:34567/zhangjinghong/vits2_submit
RUN mkdir -p /models/vits2-mix/vits2/text /models/vits2-mix/frontend /models/vits2-mix/tn_cache && \
    cd /models/vits2-mix && \
    curl -fsSL -o G_B_final_int8.pth "${MODEL_BASE_URL}/G_B_final_int8.pth" && \
    curl -fsSL -o config.json "${MODEL_BASE_URL}/config.json" && \
    for f in models.py modules.py commons.py attentions.py transforms.py stft.py utils.py monotonic_align.py; do \
        curl -fsSL -o "vits2/$f" "${MODEL_BASE_URL}/vits2_src/$f"; \
    done && \
    curl -fsSL -o vits2/text/__init__.py "${MODEL_BASE_URL}/vits2_src/text/__init__.py" && \
    curl -fsSL -o vits2/text/symbols.py "${MODEL_BASE_URL}/vits2_src/text/symbols.py" && \
    for f in __init__.py cleaner.py chinese.py english.py heteronym.py tone_sandhi.py unified_g2p.py symbols.py cmudict.rep cmudict_cache.pickle; do \
        curl -fsSL -o "frontend/$f" "${MODEL_BASE_URL}/frontend/$f"; \
    done && \
    curl -fsSL -o frontend/opencpop-strict.txt "${MODEL_BASE_URL}/opencpop-strict.txt" && \
    for f in zh_tn_tagger.fst zh_tn_verbalizer.fst en_tn_tagger.fst en_tn_verbalizer.fst; do \
        curl -fsSL -o "tn_cache/$f" "${MODEL_BASE_URL}/tn_cache/$f"; \
    done && \
    echo "Model files:" && ls -lh G_B_final_int8.pth config.json && \
    python3 -c "import site,os; p=os.path.join(site.getsitepackages()[0],'tn','chinese'); os.makedirs(p,exist_ok=True); open(os.path.join(p,'normalizer.py'),'w').write('class Normalizer:\\n    def __init__(self,**kw):pass\\n    def normalize(self,t):return t\\n'); open(os.path.join(os.path.dirname(p),'__init__.py'),'w').close(); open(os.path.join(p,'__init__.py'),'w').close(); print('tn stub ok')" && \
    python3 -c "import nltk; nltk.download('averaged_perceptron_tagger_eng', download_dir='/models/vits2-mix/nltk_data')" && \
    python3 -c "import nltk; nltk.download('punkt_tab', download_dir='/models/vits2-mix/nltk_data')"

# ── TRT ONNX files (engines built at container startup) ──────────────
ARG TRT_BASE_URL=http://172.28.4.81:34567/zhangjinghong/vits2_submit/trt
RUN mkdir -p /models/vits2-mix/trt && \
    cd /models/vits2-mix/trt && \
    curl -fsSL -o encoder_duration.onnx "${TRT_BASE_URL}/encoder_duration.onnx" && \
    curl -fsSL -o flow.onnx              "${TRT_BASE_URL}/flow.onnx" && \
    curl -fsSL -o decoder_spec.onnx      "${TRT_BASE_URL}/decoder_spec.onnx" && \
    echo "ONNX files:" && ls -lh

# ── Application code ─────────────────────────────────────────────
WORKDIR /work
COPY perception/main.py    /work/main.py
COPY perception/plugins/   /work/plugins/
COPY perception/utils/     /work/utils/
COPY perception/config.yaml /work/config.yaml

EXPOSE 15720 15721

RUN find /ros_ws/install /opt/ros/humble/install -type d \( -name "site-packages" -o -name "dist-packages" \) \
      > /usr/local/lib/python3.10/dist-packages/ros_ws.pth

ENV LD_LIBRARY_PATH="/ros_ws/install/audio_msgs/lib:/opt/ros/humble/install/lib:${LD_LIBRARY_PATH}"
ENV AMENT_PREFIX_PATH="/ros_ws/install/audio_msgs:/opt/ros/humble/install"

CMD ["/bin/bash", "-c", \
    "export LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libgomp.so.1 && \
     source /opt/ros/humble/install/setup.bash && \
     source /ros_ws/install/setup.bash && \
     python3 /work/main.py"]
